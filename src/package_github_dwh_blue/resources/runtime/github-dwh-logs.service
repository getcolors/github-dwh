[Unit]
Description=GitHub DWH authenticated journald gateway
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
EnvironmentFile=/etc/github-dwh/environment
Environment=LOG_API_SOCKET=/run/github-dwh/log-api.sock
RuntimeDirectory=github-dwh
RuntimeDirectoryMode=0755
ExecStart=/opt/github-dwh/.venv/bin/python /opt/github-dwh/log_api.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/run/github-dwh

[Install]
WantedBy=multi-user.target
